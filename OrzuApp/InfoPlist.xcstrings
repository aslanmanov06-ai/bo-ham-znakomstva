        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо Хам"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is needed for video calls, video messages and the profile verification selfie"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дастрасӣ ба камера барои видеозангҳо, видеопаёмҳо ва селфи барои санҷиши анкета лозим аст"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to unlock the app when it's locked"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID барои кушодани барномаи қулфшуда лозим аст"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is used to show the distance to profiles and to send it to your trusted contacts during an SOS"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҷойгиршавӣ барои нишон додани масофа то анкетаҳо ва фиристодани он ба тамосҳои боэътимод ҳангоми SOS лозим аст"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is needed for calls, voice and video messages"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дастрасӣ ба микрофон барои зангҳо, паёмҳои овозӣ ва видеоӣ лозим аст"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is needed to add photos and videos to your profile and send them in chats"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дастрасӣ ба аксҳо барои илова кардани акс ва видео ба анкета ва фиристодани онҳо ба чат лозим аст"
          }
        }
      }
    }
  },
  "version" : "1.0"
