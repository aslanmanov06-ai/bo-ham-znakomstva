    "3–32 символа: латинские буквы, цифры и «_»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–32 characters: Latin letters, digits and “_”."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–32 аломат: ҳарфҳои лотинӣ, рақамҳо ва «_»."
          }
        }
      }
    },
    "@%@ · %lld подписчиков" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@%@ · %lld subscribers"
          }
        },
        "tg" : {
          "stringUnit" : {
