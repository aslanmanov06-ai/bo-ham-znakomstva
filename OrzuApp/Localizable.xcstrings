          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳоло ҷуфт нест. Ҷуфт вақте пайдо мешавад, ки лайк мутақобил бошад ё ба паёми аввали шумо ҷавоб диҳанд."
          }
        }
      }
